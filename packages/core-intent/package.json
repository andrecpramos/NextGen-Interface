{
  "name": "@nextgen/core-intent",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrecpramos/NextGen-Interface.git",
    "directory": "packages/core-intent"
  },
  "type": "module",
  "description": "Three-stage intent router: deterministic → embedding → constrained LLM. Domain-agnostic.",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./browser": "./src/browser.ts",
    "./calibrate": "./src/calibrate.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "node eval/evaluate.js --embedder=ollama --model=qwen2.5:1.5b --topk=3",
    "eval:baseline": "node eval/evaluate.js --embedder=ollama --model=llama3.1:8b",
    "eval:floor": "node eval/evaluate.js --embedder=hashing --no-stage3 --report-targets",
    "compare": "node eval/compare.js",
    "calibrate": "node eval/calibrate.js --embedder=ollama --defer-oos",
    "inspect": "node eval/inspect.js --embedder=ollama"
  },
  "dependencies": {
    "@nextgen/core-capability": "workspace:*",
    "@nextgen/core-inference": "workspace:*"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=20"
  }
}
