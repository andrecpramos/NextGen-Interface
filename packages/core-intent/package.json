{
  "name": "@nextgen/core-intent",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrecpramos/AI-Interface.git",
    "directory": "packages/core-intent"
  },
  "type": "module",
  "description": "Three-stage intent router: deterministic → embedding → constrained LLM. Domain-agnostic.",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./browser": "./src/browser.ts",
    "./calibrate": "./src/calibrate.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "node eval/evaluate.js --embedder=ollama --model=qwen2.5:1.5b --topk=3",
    "eval:baseline": "node eval/evaluate.js --embedder=ollama --model=llama3.1:8b",
    "eval:floor": "node eval/evaluate.js --embedder=hashing --no-stage3",
    "compare": "node eval/compare.js",
    "calibrate": "node eval/calibrate.js --embedder=ollama --defer-oos",
    "inspect": "node eval/inspect.js --embedder=ollama",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@nextgen/core-capability": "workspace:*",
    "@nextgen/core-inference": "workspace:*"
  },
  "devDependencies": {},
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./config": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      },
      "./browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "./calibrate": {
        "types": "./dist/calibrate.d.ts",
        "default": "./dist/calibrate.js"
      }
    }
  }
}
