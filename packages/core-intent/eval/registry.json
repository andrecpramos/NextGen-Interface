{
  "schemaVersion": 1,
  "capabilities": [
    {
      "id": "home.dashboard",
      "kind": "navigate",
      "route": "/",
      "title": "Home",
      "description": "Open the home dashboard with an overview of balances, recent activity and budget status",
      "triggers": [
        "home",
        "dashboard",
        "main screen",
        "start",
        "overview"
      ],
      "examples": [
        "go home",
        "take me to the dashboard",
        "show me the overview"
      ]
    },
    {
      "id": "transactions.list",
      "kind": "navigate",
      "route": "/transactions",
      "title": "Transactions",
      "description": "Browse and filter the full list of recorded transactions over a period",
      "triggers": [
        "transactions",
        "my transactions",
        "transaction list",
        "all transactions"
      ],
      "params": {
        "from": {
          "type": "date",
          "required": false
        },
        "to": {
          "type": "date",
          "required": false
        },
        "category": {
          "type": "enum:Category",
          "required": false
        },
        "account": {
          "type": "enum:Account",
          "required": false
        }
      },
      "examples": [
        "show me my transactions",
        "open last month's expenses",
        "list all transactions from this week"
      ]
    },
    {
      "id": "search.transactions",
      "kind": "read",
      "route": "/transactions/search",
      "title": "Search transactions",
      "description": "Find specific transactions by merchant name, memo text or exact amount",
      "triggers": [
        "find transaction",
        "search for",
        "look for a payment",
        "which transaction"
      ],
      "params": {
        "query": {
          "type": "string",
          "required": true
        },
        "from": {
          "type": "date",
          "required": false
        },
        "to": {
          "type": "date",
          "required": false
        }
      },
      "examples": [
        "find the payment to Amazon",
        "search for transactions mentioning refund",
        "did I pay anything to the dentist"
      ]
    },
    {
      "id": "transaction.create",
      "kind": "write",
      "route": "/transactions/new",
      "title": "Add transaction",
      "description": "Record a new expense or income entry with an amount, category and date",
      "triggers": [
        "add transaction",
        "record expense",
        "log a payment",
        "new expense",
        "add income"
      ],
      "params": {
        "amount": {
          "type": "money",
          "required": true
        },
        "category": {
          "type": "enum:Category",
          "required": false
        },
        "date": {
          "type": "date",
          "required": false
        },
        "account": {
          "type": "enum:Account",
          "required": false
        },
        "merchant": {
          "type": "string",
          "required": false
        }
      },
      "examples": [
        "I spent 12 euros on coffee",
        "add an expense of 45 for groceries",
        "log 2000 salary income today"
      ]
    },
    {
      "id": "transaction.update",
      "kind": "write",
      "route": "/transactions/edit",
      "title": "Edit transaction",
      "description": "Change the amount, category or date of an existing transaction",
      "triggers": [
        "edit transaction",
        "change that transaction",
        "fix the category",
        "correct the amount"
      ],
      "params": {
        "target": {
          "type": "string",
          "required": true
        },
        "amount": {
          "type": "money",
          "required": false
        },
        "category": {
          "type": "enum:Category",
          "required": false
        },
        "date": {
          "type": "date",
          "required": false
        }
      },
      "examples": [
        "change that to groceries",
        "edit the last transaction amount to 20",
        "recategorise the Amazon payment as electronics"
      ]
    },
    {
      "id": "transaction.delete",
      "kind": "destructive",
      "route": "/transactions",
      "title": "Delete transaction",
      "description": "Permanently remove a single transaction from the record",
      "triggers": [
        "delete transaction",
        "remove that entry",
        "erase the payment"
      ],
      "params": {
        "target": {
          "type": "string",
          "required": true
        }
      },
      "examples": [
        "delete that transaction",
        "remove the duplicate coffee entry",
        "erase the last expense I added"
      ]
    },
    {
      "id": "spending.total",
      "kind": "read",
      "route": "/analytics/total",
      "title": "Total spending",
      "description": "Report the single total amount spent across all categories in a period",
      "triggers": [
        "how much did I spend",
        "total spending",
        "what did I spend overall"
      ],
      "params": {
        "from": {
          "type": "date",
          "required": false
        },
        "to": {
          "type": "date",
          "required": false
        },
        "account": {
          "type": "enum:Account",
          "required": false
        }
      },
      "examples": [
        "how much did I spend last month",
        "what's my total spending this year",
        "how much have I spent overall this week"
      ]
    },
    {
      "id": "spending.by_category",
      "kind": "read",
      "route": "/analytics/category",
      "title": "Spending by category",
      "description": "Break spending down per category, or report the amount spent on one specific category",
      "triggers": [
        "spending by category",
        "how much on",
        "category breakdown",
        "where did my money go"
      ],
      "params": {
        "category": {
          "type": "enum:Category",
          "required": false
        },
        "from": {
          "type": "date",
          "required": false
        },
        "to": {
          "type": "date",
          "required": false
        }
      },
      "examples": [
        "how much did I spend on food last month",
        "break down my spending by category",
        "what did groceries cost me this year"
      ]
    },
    {
      "id": "spending.trend",
      "kind": "read",
      "route": "/analytics/trend",
      "title": "Spending trend",
      "description": "Compare spending across consecutive periods to show whether it is rising or falling over time",
      "triggers": [
        "spending trend",
        "am I spending more",
        "compare months",
        "over time"
      ],
      "params": {
        "category": {
          "type": "enum:Category",
          "required": false
        },
        "months": {
          "type": "number",
          "required": false
        }
      },
      "examples": [
        "am I spending more than last month",
        "show my spending trend over six months",
        "is my food spending going up"
      ]
    },
    {
      "id": "budget.view",
      "kind": "navigate",
      "route": "/budget",
      "title": "Budgets",
      "description": "Open the budgets screen listing every category limit that has been configured",
      "triggers": [
        "budgets",
        "my budgets",
        "open budget",
        "budget screen"
      ],
      "examples": [
        "open my budgets",
        "show the budget screen",
        "take me to budgets"
      ]
    },
    {
      "id": "budget.status",
      "kind": "read",
      "route": "/budget",
      "title": "Budget status",
      "description": "Report how much of a budget has been used and whether it is over or under the limit",
      "triggers": [
        "am I over budget",
        "budget left",
        "how much is left",
        "on track"
      ],
      "params": {
        "category": {
          "type": "enum:Category",
          "required": false
        },
        "from": {
          "type": "date",
          "required": false
        }
      },
      "examples": [
        "am I over budget on food",
        "how much of my budget is left",
        "am I on track this month"
      ]
    },
    {
      "id": "budget.set",
      "kind": "write",
      "route": "/budget/edit",
      "title": "Set budget",
      "description": "Create or change the monthly spending limit for a category",
      "triggers": [
        "set budget",
        "change my limit",
        "budget for",
        "cap spending"
      ],
      "params": {
        "category": {
          "type": "enum:Category",
          "required": true
        },
        "amount": {
          "type": "money",
          "required": true
        }
      },
      "examples": [
        "set my food budget to 300",
        "change the groceries limit to 250 euros",
        "cap entertainment at 100 a month"
      ]
    },
    {
      "id": "budget.delete",
      "kind": "destructive",
      "route": "/budget",
      "title": "Remove budget",
      "description": "Delete the configured spending limit for a category entirely",
      "triggers": [
        "remove budget",
        "delete my limit",
        "stop tracking budget"
      ],
      "params": {
        "category": {
          "type": "enum:Category",
          "required": true
        }
      },
      "examples": [
        "remove my food budget",
        "delete the entertainment limit",
        "stop budgeting for transport"
      ]
    },
    {
      "id": "accounts.list",
      "kind": "navigate",
      "route": "/accounts",
      "title": "Accounts",
      "description": "Open the screen listing all configured accounts and cards",
      "triggers": [
        "accounts",
        "my accounts",
        "account list"
      ],
      "examples": [
        "show my accounts",
        "open the accounts screen",
        "list my cards"
      ]
    },
    {
      "id": "account.balance",
      "kind": "read",
      "route": "/accounts",
      "title": "Account balance",
      "description": "Report the current balance held in one account or across all accounts",
      "triggers": [
        "balance",
        "how much do I have",
        "what's in my account"
      ],
      "params": {
        "account": {
          "type": "enum:Account",
          "required": false
        }
      },
      "examples": [
        "what's my balance",
        "how much do I have in savings",
        "how much money is in my main account"
      ]
    },
    {
      "id": "account.create",
      "kind": "write",
      "route": "/accounts/new",
      "title": "Add account",
      "description": "Register a new account or card to track alongside the existing ones",
      "triggers": [
        "add account",
        "new account",
        "create a card"
      ],
      "params": {
        "name": {
          "type": "string",
          "required": true
        },
        "type": {
          "type": "enum:Account",
          "required": false
        }
      },
      "examples": [
        "add a savings account",
        "create a new credit card account",
        "set up an account called Holiday Fund"
      ]
    },
    {
      "id": "categories.list",
      "kind": "navigate",
      "route": "/categories",
      "title": "Categories",
      "description": "Open the screen managing the category tree used to classify transactions",
      "triggers": [
        "categories",
        "my categories",
        "manage categories"
      ],
      "examples": [
        "show my categories",
        "open category settings",
        "manage my categories"
      ]
    },
    {
      "id": "settings.open",
      "kind": "navigate",
      "route": "/settings",
      "title": "Settings",
      "description": "Open the application settings screen",
      "triggers": [
        "settings",
        "preferences",
        "options",
        "configuration"
      ],
      "examples": [
        "open settings",
        "go to preferences",
        "show me the options"
      ]
    },
    {
      "id": "settings.currency",
      "kind": "write",
      "route": "/settings/currency",
      "title": "Change currency",
      "description": "Change the default display currency used throughout the application",
      "triggers": [
        "change currency",
        "set currency",
        "switch to dollars"
      ],
      "params": {
        "currency": {
          "type": "string",
          "required": true
        }
      },
      "examples": [
        "change my currency to dollars",
        "set the currency to GBP",
        "switch everything to euros"
      ]
    },
    {
      "id": "export.data",
      "kind": "read",
      "route": "/settings/export",
      "title": "Export data",
      "description": "Export all stored financial data to a file the user can save elsewhere",
      "triggers": [
        "export",
        "download my data",
        "backup"
      ],
      "params": {
        "format": {
          "type": "string",
          "required": false
        }
      },
      "examples": [
        "export my data",
        "download everything as CSV",
        "back up my transactions"
      ]
    },
    {
      "id": "unsupported.move_money",
      "kind": "unsupported",
      "route": null,
      "title": "Moving real money",
      "description": "Making a payment, sending or transferring funds to another person, business, biller or account. Settling a bill. Any action that moves real money rather than recording that money moved.",
      "triggers": [
        "make a payment",
        "send money",
        "transfer funds"
      ],
      "params": {},
      "examples": [
        "send some money to a friend",
        "settle the gas bill",
        "move funds into my savings account"
      ],
      "refusal": "I can record and analyse your transactions, but I can't move real money. Nothing here is connected to a payment provider."
    },
    {
      "id": "unsupported.investing",
      "kind": "unsupported",
      "route": null,
      "title": "Investment and credit advice",
      "description": "Buying, selling or holding investments, shares, funds or cryptocurrency. Advice on what to invest in. Credit scores, loan eligibility and creditworthiness.",
      "triggers": [
        "investment advice",
        "credit rating"
      ],
      "params": {},
      "examples": [
        "is it a good time to buy shares",
        "put my money into a fund",
        "how good is my borrowing record"
      ],
      "refusal": "I track what you've spent and earned. I don't give investment or credit advice, and I have no access to credit data."
    },
    {
      "id": "unsupported.subscriptions",
      "kind": "unsupported",
      "route": null,
      "title": "Managing external accounts",
      "description": "Starting, changing or cancelling a subscription, contract or service with a third party. Acting on an external account rather than on the records held here.",
      "triggers": [
        "cancel a subscription",
        "change my plan"
      ],
      "params": {},
      "examples": [
        "end my gym membership",
        "downgrade my phone contract",
        "close that account with the provider"
      ],
      "refusal": "I can show you what a subscription costs you, but I can't change or cancel anything with the provider."
    },
    {
      "id": "unsupported.messaging",
      "kind": "unsupported",
      "route": null,
      "title": "Sending messages and files",
      "description": "Sending an email, message or file to someone. Phoning or contacting a person. Sharing a document or photograph with anyone outside this app.",
      "triggers": [
        "send a message",
        "email someone",
        "phone someone"
      ],
      "params": {},
      "examples": [
        "write to my landlord about this",
        "share this with someone",
        "give my sister a ring"
      ],
      "refusal": "I can't send messages or contact anyone. You can export your data and share it yourself."
    },
    {
      "id": "unsupported.reminders",
      "kind": "unsupported",
      "route": null,
      "title": "Reminders, alarms and calendar",
      "description": "Setting a reminder, alarm, timer or calendar appointment. Being prompted about something at a future time.",
      "triggers": [
        "set a reminder",
        "set an alarm",
        "add to my calendar"
      ],
      "params": {},
      "examples": [
        "nudge me about this next week",
        "wake me up early tomorrow",
        "put that in my diary"
      ],
      "refusal": "I don't set reminders or alarms. I can show you an upcoming budget, but I can't prompt you about it."
    },
    {
      "id": "unsupported.errands",
      "kind": "unsupported",
      "route": null,
      "title": "Booking and ordering things",
      "description": "Ordering goods or food, booking travel, flights, tickets or reservations. Buying anything on the user's behalf.",
      "triggers": [
        "book something",
        "order something"
      ],
      "params": {},
      "examples": [
        "get me a table for two",
        "buy tickets for the match",
        "arrange a trip to Madrid"
      ],
      "refusal": "I can't order or book anything. Once you've paid for it, I can record it as a transaction."
    },
    {
      "id": "unsupported.general",
      "kind": "unsupported",
      "route": null,
      "title": "General assistant requests",
      "description": "Anything unrelated to this person's money: the weather, the time, news, sport, jokes, trivia, general knowledge, translation, playing media, or controlling the device.",
      "triggers": [
        "what is the weather",
        "tell me a joke",
        "what time is it"
      ],
      "params": {},
      "examples": [
        "will it rain at the weekend",
        "say something funny",
        "how do you say this in another language"
      ],
      "refusal": "That's outside what I do — I'm here for your accounts, spending and budgets."
    }
  ],
