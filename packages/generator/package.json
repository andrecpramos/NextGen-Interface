{
  "version": "0.1.0",
  "name": "@nextgen/generator",
  "main": "./dist/index.js",
  "description": "Reads an application's source and emits one role-scoped capability registry per role, plus a report of everything it refused to declare.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "generate": "node --experimental-strip-types src/cli.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@nextgen/core-capability": "workspace:*",
    "@nextgen/core-intent": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "types": "./dist/index.d.ts"
}
