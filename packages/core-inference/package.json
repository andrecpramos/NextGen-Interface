{
  "version": "0.1.0",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrecpramos/AI-Interface.git",
    "directory": "packages/core-inference"
  },
  "name": "@nextgen/core-inference",
  "main": "./src/index.ts",
  "description": "LLM runtime adapters: Ollama (desktop), llama.rn (mobile), WebGPU (web).",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./ollama": "./src/ollama.ts",
    "./untrusted": "./src/untrusted.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./ollama": {
        "types": "./dist/ollama.d.ts",
        "default": "./dist/ollama.js"
      },
      "./untrusted": {
        "types": "./dist/untrusted.d.ts",
        "default": "./dist/untrusted.js"
      }
    }
  }
}
