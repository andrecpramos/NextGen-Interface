{
  "name": "nextgen-interface",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-native application platform. Conversation is the interface; screens are what the AI drives.",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "web": "pnpm --filter @nextgen/web dev",
    "web:build": "pnpm --filter @nextgen/web build",
    "web:start": "pnpm --filter @nextgen/web start",
    "app": "pnpm --filter @nextgen/cli start",
    "app:offline": "pnpm --filter @nextgen/cli start:offline",
    "check": "pnpm typecheck && pnpm test && pnpm registry:check",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "registry:build": "pnpm --filter @nextgen/domain-modules registry:build",
    "registry:check": "pnpm --filter @nextgen/domain-modules registry:build -- --check",
    "registry:build:finance": "pnpm --filter @nextgen/domain-finance registry:build",
    "router:eval": "pnpm --filter @nextgen/core-intent eval",
    "router:baseline": "pnpm --filter @nextgen/core-intent eval:baseline",
    "router:floor": "pnpm --filter @nextgen/core-intent eval:floor",
    "router:calibrate": "pnpm --filter @nextgen/core-intent calibrate",
    "router:inspect": "pnpm --filter @nextgen/core-intent inspect",
    "router:compare": "pnpm --filter @nextgen/core-intent compare",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo .next"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
