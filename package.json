{
  "name": "nextgen-interface",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "A drop-in AI navigation layer for a web app that already exists. Copied as one folder, not installed.",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preview": "node packages/embed/build.mjs && node preview/serve.mjs",
    "preview:check": "node packages/embed/build.mjs && node preview/check-bench.mjs",
    "adapter:build": "node packages/embed/build.mjs && node tooling/scripts/build-adapter.mjs",
    "adapter:check": "node tooling/scripts/build-adapter.mjs --check && node tooling/scripts/check-adapter.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm registry:check",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "registry:check": "node --experimental-strip-types tooling/scripts/check-registries.mjs",
    "router:eval": "pnpm --filter @nextgen/core-intent eval -- --registry=eval/fixture-registry.json",
    "router:baseline": "pnpm --filter @nextgen/core-intent eval:baseline -- --registry=eval/fixture-registry.json",
    "router:floor": "pnpm --filter @nextgen/core-intent eval:floor -- --registry=eval/fixture-registry.json",
    "router:calibrate": "pnpm --filter @nextgen/core-intent calibrate -- --registry=eval/fixture-registry.json",
    "router:inspect": "pnpm --filter @nextgen/core-intent inspect -- --registry=eval/fixture-registry.json",
    "router:compare": "pnpm --filter @nextgen/core-intent compare",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo .next",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "pack:release": "node tooling/scripts/pack-release.mjs",
    "eval:apps": "node --experimental-strip-types eval/frameworks/evaluate-golden.mjs --embedder hashing",
    "eval:apps:check": "node --experimental-strip-types eval/frameworks/evaluate-golden.mjs --embedder hashing --check",
    "eval:calibrate": "node --experimental-strip-types eval/frameworks/calibrate-registries.mjs --embedder hashing"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "axe-core": "^4.13.0",
    "esbuild": "0.25.12",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
