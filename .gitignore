# supabase local
infrastructure/supabase/.branches/
infrastructure/supabase/.temp/

# NOTE: eval/scorecards/ is intentionally NOT ignored.
# Golden-set accuracy must be visible in the diff — see .claude/sdlc/testing.md.

# Claude Code — personal, per-machine overrides. Everything else under .claude/
# IS committed: the ADRs are cited from source, and the hooks are the only layer
# that actually enforces the branching contract.
.claude/settings.local.json

# The portable SDLC kit lives outside this repo and is reused across projects.
# Ignored here so a working copy dropped in for a bootstrap is never committed.
sdlc-kit/

# WP-44: the owner's voice recordings. Audio of a real person, kept local by
# default — the measurement they feed (voice-acceptance.real.json) is committed,
# the recordings themselves are not.
eval/fut-app/recordings/

